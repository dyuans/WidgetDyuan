{
  "_comment": "恶女Online 任务库。内核是边界感与自我优先，不是对别人不好。标准同上：非常容易做到，但做完对自己确实有用。",
  "tasks": [
    { "text": "今天有一次不解释理由", "type": "日常", "rarity": "N", "tag": "边界" },
    { "text": "把「我尽量」换成「我看看」", "type": "日常", "rarity": "N", "tag": "措辞" },
    { "text": "别人夸你时只说「谢谢」，不补充", "type": "日常", "rarity": "N", "tag": "措辞" },
    { "text": "把消息里的「不好意思」删掉再发", "type": "日常", "rarity": "N", "tag": "措辞" },
    { "text": "把「都可以」改成一个具体选项", "type": "日常", "rarity": "N", "tag": "措辞" },
    { "text": "把「随便」改成「我要这个」", "type": "日常", "rarity": "N", "tag": "措辞" },
    { "text": "把一句话里的「可能」「大概」删掉", "type": "日常", "rarity": "N", "tag": "措辞" },
    { "text": "把「麻烦你了」换成「拜托了」", "type": "日常", "rarity": "N", "tag": "措辞" },
    { "text": "把「对不起我」开头的话改成「谢谢你」", "type": "日常", "rarity": "N", "tag": "措辞" },
    { "text": "点你真正想吃的那一家", "type": "日常", "rarity": "N", "tag": "自我优先" },
    { "text": "今天穿你觉得好看但怕太张扬的那件", "type": "日常", "rarity": "N", "tag": "自我优先" },
    { "text": "先满足自己一个小需求，再开始干活", "type": "日常", "rarity": "N", "tag": "自我优先" },
    { "text": "先照镜子，说一句自己的优点", "type": "日常", "rarity": "N", "tag": "自我优先" },
    { "text": "免打扰开到晚上", "type": "日常", "rarity": "N", "tag": "边界" },
    { "text": "今天不主动找话题", "type": "日常", "rarity": "N", "tag": "边界" },
    { "text": "只回复你想回复的那一条", "type": "日常", "rarity": "N", "tag": "边界" },
    { "text": "不为回消息慢道歉", "type": "日常", "rarity": "N", "tag": "边界" },
    { "text": "今天不为自己的外表说抱歉", "type": "日常", "rarity": "N", "tag": "自我优先" },
    { "text": "睡前不复盘今天说错的话", "type": "日常", "rarity": "N", "tag": "心" },

    { "text": "拒绝一件你本来会勉强答应的小事", "type": "支线", "rarity": "R", "tag": "边界" },
    { "text": "有人问你意见时，先说自己的", "type": "支线", "rarity": "R", "tag": "自我优先" },
    { "text": "退出一个让你不舒服的群", "type": "支线", "rarity": "R", "tag": "边界" },
    { "text": "取关一个看了会不舒服的账号", "type": "支线", "rarity": "R", "tag": "边界" },
    { "text": "把没做完的事直接说没做完，不找理由", "type": "支线", "rarity": "R", "tag": "措辞" },
    { "text": "把一个「应该」换成「我想」", "type": "支线", "rarity": "R", "tag": "措辞" },
    { "text": "把一件你不想做的事，往后排一天", "type": "支线", "rarity": "R", "tag": "边界" },
    { "text": "记下一件你不想再做的事", "type": "支线", "rarity": "R", "tag": "心" },
    { "text": "不替别人的情绪找借口", "type": "支线", "rarity": "R", "tag": "心" },
    { "text": "今天不为别人的迟到找理由", "type": "支线", "rarity": "R", "tag": "心" },
    { "text": "今天不解释你为什么一个人", "type": "支线", "rarity": "R", "tag": "边界" },
    { "text": "有人插队时，说一句「我在排队」", "type": "支线", "rarity": "R", "tag": "边界" },
    { "text": "先挂一次电话", "type": "支线", "rarity": "R", "tag": "边界" },
    { "text": "今天不替谁买单", "type": "支线", "rarity": "R", "tag": "自我优先" },

    { "text": "有人打断你时，说「我还没说完」", "type": "主线", "rarity": "SR", "tag": "边界" },
    { "text": "拒绝一次你不想接的电话", "type": "主线", "rarity": "SR", "tag": "边界" },
    { "text": "对一个你不想去的邀约说不", "type": "主线", "rarity": "SR", "tag": "边界" },
    { "text": "拒绝一次额外的活儿，哪怕很小", "type": "主线", "rarity": "SR", "tag": "边界" },
    { "text": "有人越界时，说一句「这个我不方便」", "type": "主线", "rarity": "SR", "tag": "边界" },
    { "text": "提一个你一直没提的小要求", "type": "主线", "rarity": "SSR", "tag": "自我优先" },
    { "text": "把手机里那条一直没发出去的话发出去", "type": "主线", "rarity": "SSR", "tag": "心" }
