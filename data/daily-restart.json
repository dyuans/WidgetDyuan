{
  "_comment": "每日重启的内容源。quotes 全部出自典籍、诗词或已出版著作，src 为可考出处；mood 分六类（起身/允许/清醒/距离/有趣/具体），仅作分类标记，抽取时不区分。正文建议 ≤22 字，超出在锁屏组件上会被压缩。goals 是没有任何任务时的退路显示。",
  "quotes": [
    {
      "text": "长风破浪会有时，直挂云帆济沧海。",
      "src": "李白《行路难》",
      "mood": "起身"
    },
    {
      "text": "山重水复疑无路，柳暗花明又一村。",
      "src": "陆游《游山西村》",
      "mood": "起身"
    },
    {
      "text": "沉舟侧畔千帆过，病树前头万木春。",
      "src": "刘禹锡《酬乐天扬州初逢席上见赠》",
      "mood": "起身"
    },
    {
      "text": "会当凌绝顶，一览众山小。",
      "src": "杜甫《望岳》",
      "mood": "起身"
    },
    {
      "text": "千淘万漉虽辛苦，吹尽狂沙始到金。",
      "src": "刘禹锡《浪淘沙》",
      "mood": "起身"
    },
    {
      "text": "老骥伏枥，志在千里。",
      "src": "曹操《龟虽寿》",
      "mood": "起身"
    },
    {
      "text": "烈士暮年，壮心不已。",
      "src": "曹操《龟虽寿》",
      "mood": "起身"
    },
    {
      "text": "少壮不努力，老大徒伤悲。",
      "src": "汉乐府《长歌行》",
      "mood": "起身"
    },
    {
      "text": "莫等闲，白了少年头，空悲切。",
      "src": "岳飞《满江红》",
      "mood": "起身"
    },
    {
      "text": "天生我材必有用，千金散尽还复来。",
      "src": "李白《将进酒》",
      "mood": "起身"
    },
    {
      "text": "大鹏一日同风起，扶摇直上九万里。",
      "src": "李白《上李邕》",
      "mood": "起身"
    },
    {
      "text": "咬定青山不放松，立根原在破岩中。",
      "src": "郑燮《竹石》",
      "mood": "起身"
    },
    {
      "text": "千磨万击还坚劲，任尔东西南北风。",
      "src": "郑燮《竹石》",
      "mood": "起身"
    },
    {
      "text": "不畏浮云遮望眼，自缘身在最高层。",
      "src": "王安石《登飞来峰》",
      "mood": "起身"
    },
    {
      "text": "欲穷千里目，更上一层楼。",
      "src": "王之涣《登鹳雀楼》",
      "mood": "起身"
    },
    {
      "text": "江山代有才人出，各领风骚数百年。",
      "src": "赵翼《论诗》",
      "mood": "起身"
    },
    {
      "text": "纸上得来终觉浅，绝知此事要躬行。",
      "src": "陆游《冬夜读书示子聿》",
      "mood": "起身"
    },
    {
      "text": "少年辛苦终身事，莫向光阴惰寸功。",
      "src": "杜荀鹤《题弟侄书堂》",
      "mood": "起身"
    },
    {
      "text": "亦余心之所善兮，虽九死其犹未悔。",
      "src": "屈原《离骚》",
      "mood": "起身"
    },
    {
      "text": "路漫漫其修远兮，吾将上下而求索。",
      "src": "屈原《离骚》",
      "mood": "起身"
    },
    {
      "text": "男儿何不带吴钩，收取关山五十州。",
      "src": "李贺《南园》",
      "mood": "起身"
    },
    {
      "text": "我劝天公重抖擞，不拘一格降人才。",
      "src": "龚自珍《己亥杂诗》",
      "mood": "起身"
    },
    {
      "text": "落红不是无情物，化作春泥更护花。",
      "src": "龚自珍《己亥杂诗》",
      "mood": "起身"
    },
    {
      "text": "春风得意马蹄疾，一日看尽长安花。",
      "src": "孟郊《登科后》",
      "mood": "起身"
    },
    {
      "text": "人生自古谁无死，留取丹心照汗青。",
      "src": "文天祥《过零丁洋》",
      "mood": "起身"
    },
    {
      "text": "粉身碎骨浑不怕，要留清白在人间。",
      "src": "于谦《石灰吟》",
      "mood": "起身"
    },
    {
      "text": "莫愁前路无知己，天下谁人不识君。",
      "src": "高适《别董大》",
      "mood": "起身"
    },
    {
      "text": "野火烧不尽，春风吹又生。",
      "src": "白居易《赋得古原草送别》",
      "mood": "起身"
    },
    {
      "text": "天行健，君子以自强不息。",
      "src": "《周易·乾卦》",
      "mood": "起身"
    },
    {
      "text": "地势坤，君子以厚德载物。",
      "src": "《周易·坤卦》",
      "mood": "起身"
    },
    {
      "text": "穷则变，变则通，通则久。",
      "src": "《周易·系辞下》",
      "mood": "起身"
    },
    {
      "text": "不积跬步，无以至千里。",
      "src": "《荀子·劝学》",
      "mood": "起身"
    },
    {
      "text": "锲而不舍，金石可镂。",
      "src": "《荀子·劝学》",
      "mood": "起身"
    },
    {
      "text": "青，取之于蓝，而青于蓝。",
      "src": "《荀子·劝学》",
      "mood": "起身"
    },
    {
      "text": "君子生非异也，善假于物也。",
      "src": "《荀子·劝学》",
      "mood": "起身"
    },
    {
      "text": "士不可以不弘毅，任重而道远。",
      "src": "《论语·泰伯》",
      "mood": "起身"
    },
    {
      "text": "譬如为山，未成一篑，止，吾止也。",
      "src": "《论语·子罕》",
      "mood": "起身"
    },
    {
      "text": "逝者如斯夫，不舍昼夜。",
      "src": "《论语·子罕》",
      "mood": "起身"
    },
    {
      "text": "三军可夺帅也，匹夫不可夺志也。",
      "src": "《论语·子罕》",
      "mood": "起身"
    },
    {
      "text": "后生可畏，焉知来者之不如今也。",
      "src": "《论语·子罕》",
      "mood": "起身"
    },
    {
      "text": "工欲善其事，必先利其器。",
      "src": "《论语·卫灵公》",
      "mood": "起身"
    },
    {
      "text": "生于忧患，死于安乐。",
      "src": "《孟子·告子下》",
      "mood": "起身"
    },
    {
      "text": "穷则独善其身，达则兼济天下。",
      "src": "《孟子·尽心上》",
      "mood": "起身"
    },
    {
      "text": "静以修身，俭以养德。",
      "src": "诸葛亮《诫子书》",
      "mood": "起身"
    },
    {
      "text": "非淡泊无以明志，非宁静无以致远。",
      "src": "诸葛亮《诫子书》",
      "mood": "起身"
    },
    {
      "text": "勿以恶小而为之，勿以善小而不为。",
      "src": "《三国志》先主遗诏",
      "mood": "起身"
    },
    {
      "text": "玉不琢，不成器。",
      "src": "《礼记·学记》",
      "mood": "起身"
    },
    {
      "text": "独学而无友，则孤陋而寡闻。",
      "src": "《礼记·学记》",
      "mood": "起身"
    },
    {
      "text": "满招损，谦受益。",
      "src": "《尚书·大禹谟》",
      "mood": "起身"
    },
    {
      "text": "千里之堤，溃于蚁穴。",
      "src": "《韩非子·喻老》",
      "mood": "起身"
    },
    {
      "text": "采菊东篱下，悠然见南山。",
      "src": "陶渊明《饮酒·其五》",
      "mood": "允许"
    },
    {
      "text": "结庐在人境，而无车马喧。",
      "src": "陶渊明《饮酒·其五》",
      "mood": "允许"
    },
    {
      "text": "悟已往之不谏，知来者之可追。",
      "src": "陶渊明《归去来兮辞》",
      "mood": "允许"
    },
    {
      "text": "云无心以出岫，鸟倦飞而知还。",
      "src": "陶渊明《归去来兮辞》",
      "mood": "允许"
    },
    {
      "text": "归去来兮，田园将芜胡不归。",
      "src": "陶渊明《归去来兮辞》",
      "mood": "允许"
    },
    {
      "text": "莫听穿林打叶声，何妨吟啸且徐行。",
      "src": "苏轼《定风波》",
      "mood": "允许"
    },
    {
      "text": "回首向来萧瑟处，也无风雨也无晴。",
      "src": "苏轼《定风波》",
      "mood": "允许"
    },
    {
      "text": "一蓑烟雨任平生。",
      "src": "苏轼《定风波》",
      "mood": "允许"
    },
    {
      "text": "此心安处是吾乡。",
      "src": "苏轼《定风波·南海归赠王定国侍人寓娘》",
      "mood": "允许"
    },
    {
      "text": "人间有味是清欢。",
      "src": "苏轼《浣溪沙》",
      "mood": "允许"
    },
    {
      "text": "谁道人生无再少？门前流水尚能西。",
      "src": "苏轼《浣溪沙》",
      "mood": "允许"
    },
    {
      "text": "休将白发唱黄鸡。",
      "src": "苏轼《浣溪沙》",
      "mood": "允许"
    },
    {
      "text": "行到水穷处，坐看云起时。",
      "src": "王维《终南别业》",
      "mood": "允许"
    },
    {
      "text": "偶然值林叟，谈笑无还期。",
      "src": "王维《终南别业》",
      "mood": "允许"
    },
    {
      "text": "松风吹解带，山月照弹琴。",
      "src": "王维《酬张少府》",
      "mood": "允许"
    },
    {
      "text": "晚年唯好静，万事不关心。",
      "src": "王维《酬张少府》",
      "mood": "允许"
    },
    {
      "text": "明月松间照，清泉石上流。",
      "src": "王维《山居秋暝》",
      "mood": "允许"
    },
    {
      "text": "随意春芳歇，王孙自可留。",
      "src": "王维《山居秋暝》",
      "mood": "允许"
    },
    {
      "text": "但去莫复问，白云无尽时。",
      "src": "王维《送别》",
      "mood": "允许"
    },
    {
      "text": "偷得浮生半日闲。",
      "src": "李涉《题鹤林寺僧舍》",
      "mood": "允许"
    },
    {
      "text": "春有百花秋有月，夏有凉风冬有雪。",
      "src": "慧开禅师《无门关》",
      "mood": "允许"
    },
    {
      "text": "若无闲事挂心头，便是人间好时节。",
      "src": "慧开禅师《无门关》",
      "mood": "允许"
    },
    {
      "text": "不如意事常八九，可与语人无二三。",
      "src": "方岳《别子才司令》",
      "mood": "允许"
    },
    {
      "text": "宠辱不惊，看庭前花开花落。",
      "src": "《菜根谭》",
      "mood": "允许"
    },
    {
      "text": "去留无意，望天上云卷云舒。",
      "src": "《菜根谭》",
      "mood": "允许"
    },
    {
      "text": "花看半开，酒饮微醺。",
      "src": "《菜根谭》",
      "mood": "允许"
    },
    {
      "text": "处世让一步为高，退步即进步的张本。",
      "src": "《菜根谭》",
      "mood": "允许"
    },
    {
      "text": "风来疏竹，风过而竹不留声。",
      "src": "《菜根谭》",
      "mood": "允许"
    },
    {
      "text": "雁渡寒潭，雁去而潭不留影。",
      "src": "《菜根谭》",
      "mood": "允许"
    },
    {
      "text": "相濡以沫，不如相忘于江湖。",
      "src": "《庄子·大宗师》",
      "mood": "允许"
    },
    {
      "text": "鹪鹩巢于深林，不过一枝。",
      "src": "《庄子·逍遥游》",
      "mood": "允许"
    },
    {
      "text": "偃鼠饮河，不过满腹。",
      "src": "《庄子·逍遥游》",
      "mood": "允许"
    },
    {
      "text": "至人无己，神人无功，圣人无名。",
      "src": "《庄子·逍遥游》",
      "mood": "允许"
    },
    {
      "text": "人皆知有用之用，而莫知无用之用。",
      "src": "《庄子·人间世》",
      "mood": "允许"
    },
    {
      "text": "塞翁失马，焉知非福。",
      "src": "《淮南子·人间训》",
      "mood": "允许"
    },
    {
      "text": "亡羊补牢，未为迟也。",
      "src": "《战国策·楚策》",
      "mood": "允许"
    },
    {
      "text": "我与我周旋久，宁作我。",
      "src": "《世说新语·品藻》",
      "mood": "允许"
    },
    {
      "text": "乘兴而来，兴尽而返，何必见戴。",
      "src": "《世说新语·任诞》",
      "mood": "允许"
    },
    {
      "text": "不识庐山真面目，只缘身在此山中。",
      "src": "苏轼《题西林壁》",
      "mood": "清醒"
    },
    {
      "text": "横看成岭侧成峰，远近高低各不同。",
      "src": "苏轼《题西林壁》",
      "mood": "清醒"
    },
    {
      "text": "问渠那得清如许？为有源头活水来。",
      "src": "朱熹《观书有感》",
      "mood": "清醒"
    },
    {
      "text": "人生如逆旅，我亦是行人。",
      "src": "苏轼《临江仙·送钱穆父》",
      "mood": "清醒"
    },
    {
      "text": "长恨此身非我有，何时忘却营营。",
      "src": "苏轼《临江仙·夜归临皋》",
      "mood": "清醒"
    },
    {
      "text": "世事一场大梦，人生几度秋凉。",
      "src": "苏轼《西江月》",
      "mood": "清醒"
    },
    {
      "text": "人有悲欢离合，月有阴晴圆缺。",
      "src": "苏轼《水调歌头》",
      "mood": "清醒"
    },
    {
      "text": "此事古难全。",
      "src": "苏轼《水调歌头》",
      "mood": "清醒"
    },
    {
      "text": "蚍蜉撼大树，可笑不自量。",
      "src": "韩愈《调张籍》",
      "mood": "清醒"
    },
    {
      "text": "尔曹身与名俱灭，不废江河万古流。",
      "src": "杜甫《戏为六绝句》",
      "mood": "清醒"
    },
    {
      "text": "此情可待成追忆，只是当时已惘然。",
      "src": "李商隐《锦瑟》",
      "mood": "清醒"
    },
    {
      "text": "年年岁岁花相似，岁岁年年人不同。",
      "src": "刘希夷《代悲白头翁》",
      "mood": "清醒"
    },
    {
      "text": "譬如朝露，去日苦多。",
      "src": "曹操《短歌行》",
      "mood": "清醒"
    },
    {
      "text": "对酒当歌，人生几何。",
      "src": "曹操《短歌行》",
      "mood": "清醒"
    },
    {
      "text": "人生天地间，忽如远行客。",
      "src": "《古诗十九首》",
      "mood": "清醒"
    },
    {
      "text": "明日隔山岳，世事两茫茫。",
      "src": "杜甫《赠卫八处士》",
      "mood": "清醒"
    },
    {
      "text": "欲速则不达，见小利则大事不成。",
      "src": "《论语·子路》",
      "mood": "清醒"
    },
    {
      "text": "学而不思则罔，思而不学则殆。",
      "src": "《论语·为政》",
      "mood": "清醒"
    },
    {
      "text": "知之为知之，不知为不知，是知也。",
      "src": "《论语·为政》",
      "mood": "清醒"
    },
    {
      "text": "人无远虑，必有近忧。",
      "src": "《论语·卫灵公》",
      "mood": "清醒"
    },
    {
      "text": "过而不改，是谓过矣。",
      "src": "《论语·卫灵公》",
      "mood": "清醒"
    },
    {
      "text": "君子求诸己，小人求诸人。",
      "src": "《论语·卫灵公》",
      "mood": "清醒"
    },
    {
      "text": "君子和而不同，小人同而不和。",
      "src": "《论语·子路》",
      "mood": "清醒"
    },
    {
      "text": "见贤思齐焉，见不贤而内自省也。",
      "src": "《论语·里仁》",
      "mood": "清醒"
    },
    {
      "text": "不患人之不己知，患不知人也。",
      "src": "《论语·学而》",
      "mood": "清醒"
    },
    {
      "text": "知者不惑，仁者不忧，勇者不惧。",
      "src": "《论语·子罕》",
      "mood": "清醒"
    },
    {
      "text": "岁寒，然后知松柏之后凋也。",
      "src": "《论语·子罕》",
      "mood": "清醒"
    },
    {
      "text": "己所不欲，勿施于人。",
      "src": "《论语·卫灵公》",
      "mood": "清醒"
    },
    {
      "text": "温故而知新，可以为师矣。",
      "src": "《论语·为政》",
      "mood": "清醒"
    },
    {
      "text": "三人行，必有我师焉。",
      "src": "《论语·述而》",
      "mood": "清醒"
    },
    {
      "text": "不义而富且贵，于我如浮云。",
      "src": "《论语·述而》",
      "mood": "清醒"
    },
    {
      "text": "德不孤，必有邻。",
      "src": "《论语·里仁》",
      "mood": "清醒"
    },
    {
      "text": "朝闻道，夕死可矣。",
      "src": "《论语·里仁》",
      "mood": "清醒"
    },
    {
      "text": "吾生也有涯，而知也无涯。",
      "src": "《庄子·养生主》",
      "mood": "清醒"
    },
    {
      "text": "井蛙不可以语于海，夏虫不可以语冰。",
      "src": "《庄子·秋水》",
      "mood": "清醒"
    },
    {
      "text": "巧者劳而智者忧，无能者无所求。",
      "src": "《庄子·列御寇》",
      "mood": "清醒"
    },
    {
      "text": "大知闲闲，小知间间。",
      "src": "《庄子·齐物论》",
      "mood": "清醒"
    },
    {
      "text": "尽信书，则不如无书。",
      "src": "《孟子·尽心下》",
      "mood": "清醒"
    },
    {
      "text": "富贵不能淫，贫贱不能移，威武不能屈。",
      "src": "《孟子·滕文公下》",
      "mood": "清醒"
    },
    {
      "text": "智者千虑，必有一失。",
      "src": "《史记·淮阴侯列传》",
      "mood": "清醒"
    },
    {
      "text": "桃李不言，下自成蹊。",
      "src": "《史记·李将军列传》",
      "mood": "清醒"
    },
    {
      "text": "尺有所短，寸有所长。",
      "src": "《楚辞·卜居》",
      "mood": "清醒"
    },
    {
      "text": "举世皆浊我独清，众人皆醉我独醒。",
      "src": "《楚辞·渔父》",
      "mood": "清醒"
    },
    {
      "text": "前事不忘，后事之师。",
      "src": "《战国策·赵策》",
      "mood": "清醒"
    },
    {
      "text": "少年读书，如隙中窥月。",
      "src": "张潮《幽梦影》",
      "mood": "清醒"
    },
    {
      "text": "中年读书，如庭中望月。",
      "src": "张潮《幽梦影》",
      "mood": "清醒"
    },
    {
      "text": "老年读书，如台上玩月。",
      "src": "张潮《幽梦影》",
      "mood": "清醒"
    },
    {
      "text": "情必近于痴而始真。",
      "src": "张潮《幽梦影》",
      "mood": "清醒"
    },
    {
      "text": "交友须带三分侠气，做人要存一点素心。",
      "src": "《菜根谭》",
      "mood": "清醒"
    },
    {
      "text": "寄蜉蝣于天地，渺沧海之一粟。",
      "src": "苏轼《前赤壁赋》",
      "mood": "距离"
    },
    {
      "text": "哀吾生之须臾，羡长江之无穷。",
      "src": "苏轼《前赤壁赋》",
      "mood": "距离"
    },
    {
      "text": "惟江上之清风，与山间之明月。",
      "src": "苏轼《前赤壁赋》",
      "mood": "距离"
    },
    {
      "text": "大江东去，浪淘尽，千古风流人物。",
      "src": "苏轼《念奴娇·赤壁怀古》",
      "mood": "距离"
    },
    {
      "text": "人生如梦，一尊还酹江月。",
      "src": "苏轼《念奴娇·赤壁怀古》",
      "mood": "距离"
    },
    {
      "text": "但愿人长久，千里共婵娟。",
      "src": "苏轼《水调歌头》",
      "mood": "距离"
    },
    {
      "text": "星垂平野阔，月涌大江流。",
      "src": "杜甫《旅夜书怀》",
      "mood": "距离"
    },
    {
      "text": "飘飘何所似，天地一沙鸥。",
      "src": "杜甫《旅夜书怀》",
      "mood": "距离"
    },
    {
      "text": "无边落木萧萧下，不尽长江滚滚来。",
      "src": "杜甫《登高》",
      "mood": "距离"
    },
    {
      "text": "前不见古人，后不见来者。",
      "src": "陈子昂《登幽州台歌》",
      "mood": "距离"
    },
    {
      "text": "念天地之悠悠，独怆然而涕下。",
      "src": "陈子昂《登幽州台歌》",
      "mood": "距离"
    },
    {
      "text": "海内存知己，天涯若比邻。",
      "src": "王勃《送杜少府之任蜀州》",
      "mood": "距离"
    },
    {
      "text": "落霞与孤鹜齐飞，秋水共长天一色。",
      "src": "王勃《滕王阁序》",
      "mood": "距离"
    },
    {
      "text": "关山难越，谁悲失路之人。",
      "src": "王勃《滕王阁序》",
      "mood": "距离"
    },
    {
      "text": "老当益壮，宁移白首之心。",
      "src": "王勃《滕王阁序》",
      "mood": "距离"
    },
    {
      "text": "大漠孤烟直，长河落日圆。",
      "src": "王维《使至塞上》",
      "mood": "距离"
    },
    {
      "text": "孤帆远影碧空尽，唯见长江天际流。",
      "src": "李白《黄鹤楼送孟浩然之广陵》",
      "mood": "距离"
    },
    {
      "text": "夫天地者，万物之逆旅也。",
      "src": "李白《春夜宴从弟桃花园序》",
      "mood": "距离"
    },
    {
      "text": "光阴者，百代之过客也。",
      "src": "李白《春夜宴从弟桃花园序》",
      "mood": "距离"
    },
    {
      "text": "江畔何人初见月？江月何年初照人。",
      "src": "张若虚《春江花月夜》",
      "mood": "距离"
    },
    {
      "text": "人生代代无穷已，江月年年只相似。",
      "src": "张若虚《春江花月夜》",
      "mood": "距离"
    },
    {
      "text": "山川异域，风月同天。",
      "src": "长屋王《绣袈裟衣缘》",
      "mood": "距离"
    },
    {
      "text": "人生天地之间，若白驹之过隙。",
      "src": "《庄子·知北游》",
      "mood": "距离"
    },
    {
      "text": "天地有大美而不言。",
      "src": "《庄子·知北游》",
      "mood": "距离"
    },
    {
      "text": "人固有一死，或重于泰山，或轻于鸿毛。",
      "src": "司马迁《报任安书》",
      "mood": "距离"
    },
    {
      "text": "木犹如此，人何以堪。",
      "src": "《世说新语·言语》",
      "mood": "距离"
    },
    {
      "text": "大道之行也，天下为公。",
      "src": "《礼记·礼运》",
      "mood": "距离"
    },
    {
      "text": "秦时明月汉时关，万里长征人未还。",
      "src": "王昌龄《出塞》",
      "mood": "距离"
    },
    {
      "text": "莫笑农家腊酒浑，丰年留客足鸡豚。",
      "src": "陆游《游山西村》",
      "mood": "距离"
    },
    {
      "text": "青山遮不住，毕竟东流去。",
      "src": "辛弃疾《菩萨蛮·书江西造口壁》",
      "mood": "距离"
    },
    {
      "text": "千古兴亡多少事？悠悠。",
      "src": "辛弃疾《南乡子·登京口北固亭有怀》",
      "mood": "距离"
    },
    {
      "text": "不尽长江滚滚流。",
      "src": "辛弃疾《南乡子·登京口北固亭有怀》",
      "mood": "距离"
    },
    {
      "text": "我醉欲眠卿且去，明朝有意抱琴来。",
      "src": "李白《山中与幽人对酌》",
      "mood": "有趣"
    },
    {
      "text": "两人对酌山花开，一杯一杯复一杯。",
      "src": "李白《山中与幽人对酌》",
      "mood": "有趣"
    },
    {
      "text": "天子呼来不上船，自称臣是酒中仙。",
      "src": "杜甫《饮中八仙歌》",
      "mood": "有趣"
    },
    {
      "text": "儿童相见不相识，笑问客从何处来。",
      "src": "贺知章《回乡偶书》",
      "mood": "有趣"
    },
    {
      "text": "卷地风来忽吹散，望湖楼下水如天。",
      "src": "苏轼《六月二十七日望湖楼醉书》",
      "mood": "有趣"
    },
    {
      "text": "竹外桃花三两枝，春江水暖鸭先知。",
      "src": "苏轼《惠崇春江晚景》",
      "mood": "有趣"
    },
    {
      "text": "日啖荔枝三百颗，不辞长作岭南人。",
      "src": "苏轼《惠州一绝》",
      "mood": "有趣"
    },
    {
      "text": "忽如一夜春风来，千树万树梨花开。",
      "src": "岑参《白雪歌送武判官归京》",
      "mood": "有趣"
    },
    {
      "text": "儿童急走追黄蝶，飞入菜花无处寻。",
      "src": "杨万里《宿新市徐公店》",
      "mood": "有趣"
    },
    {
      "text": "小荷才露尖尖角，早有蜻蜓立上头。",
      "src": "杨万里《小池》",
      "mood": "有趣"
    },
    {
      "text": "接天莲叶无穷碧，映日荷花别样红。",
      "src": "杨万里《晓出净慈寺送林子方》",
      "mood": "有趣"
    },
    {
      "text": "儿童散学归来早，忙趁东风放纸鸢。",
      "src": "高鼎《村居》",
      "mood": "有趣"
    },
    {
      "text": "最喜小儿亡赖，溪头卧剥莲蓬。",
      "src": "辛弃疾《清平乐·村居》",
      "mood": "有趣"
    },
    {
      "text": "稻花香里说丰年，听取蛙声一片。",
      "src": "辛弃疾《西江月》",
      "mood": "有趣"
    },
    {
      "text": "醉里挑灯看剑，梦回吹角连营。",
      "src": "辛弃疾《破阵子》",
      "mood": "有趣"
    },
    {
      "text": "蓦然回首，那人却在灯火阑珊处。",
      "src": "辛弃疾《青玉案·元夕》",
      "mood": "有趣"
    },
    {
      "text": "众里寻他千百度。",
      "src": "辛弃疾《青玉案·元夕》",
      "mood": "有趣"
    },
    {
      "text": "稚子敲针作钓钩。",
      "src": "杜甫《江村》",
      "mood": "有趣"
    },
    {
      "text": "老妻画纸为棋局。",
      "src": "杜甫《江村》",
      "mood": "有趣"
    },
    {
      "text": "白日放歌须纵酒，青春作伴好还乡。",
      "src": "杜甫《闻官军收河南河北》",
      "mood": "有趣"
    },
    {
      "text": "莫笑老翁犹气岸，君看，几人黄菊上华颠。",
      "src": "黄庭坚《定风波》",
      "mood": "有趣"
    },
    {
      "text": "人生得意须尽欢，莫使金樽空对月。",
      "src": "李白《将进酒》",
      "mood": "有趣"
    },
    {
      "text": "仰天大笑出门去，我辈岂是蓬蒿人。",
      "src": "李白《南陵别儿童入京》",
      "mood": "有趣"
    },
    {
      "text": "绿蚁新醅酒，红泥小火炉。",
      "src": "白居易《问刘十九》",
      "mood": "有趣"
    },
    {
      "text": "晚来天欲雪，能饮一杯无？",
      "src": "白居易《问刘十九》",
      "mood": "有趣"
    },
    {
      "text": "春听鸟声，夏听蝉声。",
      "src": "张潮《幽梦影》",
      "mood": "有趣"
    },
    {
      "text": "秋听虫声，冬听雪声。",
      "src": "张潮《幽梦影》",
      "mood": "有趣"
    },
    {
      "text": "空山不见人，但闻人语响。",
      "src": "王维《鹿柴》",
      "mood": "具体"
    },
    {
      "text": "返景入深林，复照青苔上。",
      "src": "王维《鹿柴》",
      "mood": "具体"
    },
    {
      "text": "独坐幽篁里，弹琴复长啸。",
      "src": "王维《竹里馆》",
      "mood": "具体"
    },
    {
      "text": "深林人不知，明月来相照。",
      "src": "王维《竹里馆》",
      "mood": "具体"
    },
    {
      "text": "木末芙蓉花，山中发红萼。",
      "src": "王维《辛夷坞》",
      "mood": "具体"
    },
    {
      "text": "涧户寂无人，纷纷开且落。",
      "src": "王维《辛夷坞》",
      "mood": "具体"
    },
    {
      "text": "人闲桂花落，夜静春山空。",
      "src": "王维《鸟鸣涧》",
      "mood": "具体"
    },
    {
      "text": "月出惊山鸟，时鸣春涧中。",
      "src": "王维《鸟鸣涧》",
      "mood": "具体"
    },
    {
      "text": "千山鸟飞绝，万径人踪灭。",
      "src": "柳宗元《江雪》",
      "mood": "具体"
    },
    {
      "text": "孤舟蓑笠翁，独钓寒江雪。",
      "src": "柳宗元《江雪》",
      "mood": "具体"
    },
    {
      "text": "白日依山尽，黄河入海流。",
      "src": "王之涣《登鹳雀楼》",
      "mood": "具体"
    },
    {
      "text": "野旷天低树，江清月近人。",
      "src": "孟浩然《宿建德江》",
      "mood": "具体"
    },
    {
      "text": "春眠不觉晓，处处闻啼鸟。",
      "src": "孟浩然《春晓》",
      "mood": "具体"
    },
    {
      "text": "夜来风雨声，花落知多少。",
      "src": "孟浩然《春晓》",
      "mood": "具体"
    },
    {
      "text": "疏影横斜水清浅，暗香浮动月黄昏。",
      "src": "林逋《山园小梅》",
      "mood": "具体"
    },
    {
      "text": "枯藤老树昏鸦，小桥流水人家。",
      "src": "马致远《天净沙·秋思》",
      "mood": "具体"
    },
    {
      "text": "夕阳西下，断肠人在天涯。",
      "src": "马致远《天净沙·秋思》",
      "mood": "具体"
    },
    {
      "text": "明月别枝惊鹊，清风半夜鸣蝉。",
      "src": "辛弃疾《西江月》",
      "mood": "具体"
    },
    {
      "text": "七八个星天外，两三点雨山前。",
      "src": "辛弃疾《西江月》",
      "mood": "具体"
    },
    {
      "text": "昨夜雨疏风骤，浓睡不消残酒。",
      "src": "李清照《如梦令》",
      "mood": "具体"
    },
    {
      "text": "知否，知否？应是绿肥红瘦。",
      "src": "李清照《如梦令》",
      "mood": "具体"
    },
    {
      "text": "常记溪亭日暮，沉醉不知归路。",
      "src": "李清照《如梦令》",
      "mood": "具体"
    },
    {
      "text": "争渡，争渡，惊起一滩鸥鹭。",
      "src": "李清照《如梦令》",
      "mood": "具体"
    },
    {
      "text": "莫道不销魂，帘卷西风，人比黄花瘦。",
      "src": "李清照《醉花阴》",
      "mood": "具体"
    },
    {
      "text": "蒹葭苍苍，白露为霜。",
      "src": "《诗经·秦风·蒹葭》",
      "mood": "具体"
    },
    {
      "text": "所谓伊人，在水一方。",
      "src": "《诗经·秦风·蒹葭》",
      "mood": "具体"
    },
    {
      "text": "昔我往矣，杨柳依依。",
      "src": "《诗经·小雅·采薇》",
      "mood": "具体"
    },
    {
      "text": "今我来思，雨雪霏霏。",
      "src": "《诗经·小雅·采薇》",
      "mood": "具体"
    },
    {
      "text": "桃之夭夭，灼灼其华。",
      "src": "《诗经·周南·桃夭》",
      "mood": "具体"
    },
    {
      "text": "关关雎鸠，在河之洲。",
      "src": "《诗经·周南·关雎》",
      "mood": "具体"
    },
    {
      "text": "青青子衿，悠悠我心。",
      "src": "《诗经·郑风·子衿》",
      "mood": "具体"
    },
    {
      "text": "死生契阔，与子成说。",
      "src": "《诗经·邶风·击鼓》",
      "mood": "具体"
    },
    {
      "text": "山有木兮木有枝，心悦君兮君不知。",
      "src": "《越人歌》",
      "mood": "具体"
    },
    {
      "text": "采得百花成蜜后，为谁辛苦为谁甜。",
      "src": "罗隐《蜂》",
      "mood": "具体"
    },
    {
      "text": "春蚕到死丝方尽，蜡炬成灰泪始干。",
      "src": "李商隐《无题》",
      "mood": "具体"
    },
    {
      "text": "何当共剪西窗烛，却话巴山夜雨时。",
      "src": "李商隐《夜雨寄北》",
      "mood": "具体"
    },
    {
      "text": "君问归期未有期，巴山夜雨涨秋池。",
      "src": "李商隐《夜雨寄北》",
      "mood": "具体"
    },
    {
      "text": "夕阳无限好，只是近黄昏。",
      "src": "李商隐《乐游原》",
      "mood": "具体"
    },
    {
      "text": "沧海月明珠有泪，蓝田日暖玉生烟。",
      "src": "李商隐《锦瑟》",
      "mood": "具体"
    },
    {
      "text": "停车坐爱枫林晚，霜叶红于二月花。",
      "src": "杜牧《山行》",
      "mood": "具体"
    },
    {
      "text": "银烛秋光冷画屏，轻罗小扇扑流萤。",
      "src": "杜牧《秋夕》",
      "mood": "具体"
    },
    {
      "text": "借问酒家何处有，牧童遥指杏花村。",
      "src": "杜牧《清明》",
      "mood": "具体"
    },
    {
      "text": "迟日江山丽，春风花草香。",
      "src": "杜甫《绝句二首》",
      "mood": "具体"
    },
    {
      "text": "泥融飞燕子，沙暖睡鸳鸯。",
      "src": "杜甫《绝句二首》",
      "mood": "具体"
    },
    {
      "text": "江碧鸟逾白，山青花欲燃。",
      "src": "杜甫《绝句二首》",
      "mood": "具体"
    },
    {
      "text": "两个黄鹂鸣翠柳，一行白鹭上青天。",
      "src": "杜甫《绝句四首》",
      "mood": "具体"
    },
    {
      "text": "随风潜入夜，润物细无声。",
      "src": "杜甫《春夜喜雨》",
      "mood": "具体"
    },
    {
      "text": "好雨知时节，当春乃发生。",
      "src": "杜甫《春夜喜雨》",
      "mood": "具体"
    },
    {
      "text": "独在异乡为异客，每逢佳节倍思亲。",
      "src": "王维《九月九日忆山东兄弟》",
      "mood": "具体"
    },
    {
      "text": "劝君更尽一杯酒，西出阳关无故人。",
      "src": "王维《送元二使安西》",
      "mood": "具体"
    },
    {
      "text": "举头望明月，低头思故乡。",
      "src": "李白《静夜思》",
      "mood": "具体"
    },
    {
      "text": "相看两不厌，只有敬亭山。",
      "src": "李白《独坐敬亭山》",
      "mood": "具体"
    },
    {
      "text": "众鸟高飞尽，孤云独去闲。",
      "src": "李白《独坐敬亭山》",
      "mood": "具体"
    },
    {
      "text": "桃花潭水深千尺，不及汪伦送我情。",
      "src": "李白《赠汪伦》",
      "mood": "具体"
    },
    {
      "text": "朝辞白帝彩云间，千里江陵一日还。",
      "src": "李白《早发白帝城》",
      "mood": "具体"
    },
    {
      "text": "两岸猿声啼不住，轻舟已过万重山。",
      "src": "李白《早发白帝城》",
      "mood": "具体"
    },
    {
      "text": "洛阳亲友如相问，一片冰心在玉壶。",
      "src": "王昌龄《芙蓉楼送辛渐》",
      "mood": "具体"
    },
    {
      "text": "离离原上草，一岁一枯荣。",
      "src": "白居易《赋得古原草送别》",
      "mood": "具体"
    },
    {
      "text": "乱花渐欲迷人眼，浅草才能没马蹄。",
      "src": "白居易《钱塘湖春行》",
      "mood": "具体"
    },
    {
      "text": "日出江花红胜火，春来江水绿如蓝。",
      "src": "白居易《忆江南》",
      "mood": "具体"
    },
    {
      "text": "同是天涯沦落人，相逢何必曾相识。",
      "src": "白居易《琵琶行》",
      "mood": "具体"
    },
    {
      "text": "别有幽愁暗恨生，此时无声胜有声。",
      "src": "白居易《琵琶行》",
      "mood": "具体"
    },
    {
      "text": "春天是破晓的时候最好。",
      "src": "清少纳言《枕草子》周作人译",
      "mood": "具体"
    },
    {
      "text": "夏天是夜里最好。",
      "src": "清少纳言《枕草子》周作人译",
      "mood": "具体"
    },
    {
      "text": "秋天是傍晚最好。",
      "src": "清少纳言《枕草子》周作人译",
      "mood": "具体"
    },
    {
      "text": "冬天是早晨最好。",
      "src": "清少纳言《枕草子》周作人译",
      "mood": "具体"
    },
    {
      "text": "闲寂古池旁，青蛙跳进水中央，扑通一声响。",
      "src": "松尾芭蕉·俳句",
      "mood": "具体"
    },
    {
      "text": "其实地上本没有路，走的人多了，也便成了路。",
      "src": "鲁迅《故乡》",
      "mood": "起身"
    },
    {
      "text": "希望是本无所谓有，无所谓无的。",
      "src": "鲁迅《故乡》",
      "mood": "清醒"
    },
    {
      "text": "无穷的远方，无数的人们，都和我有关。",
      "src": "鲁迅《这也是生活》",
      "mood": "距离"
    },
    {
      "text": "不在沉默中爆发，就在沉默中灭亡。",
      "src": "鲁迅《记念刘和珍君》",
      "mood": "起身"
    },
    {
      "text": "真的猛士，敢于直面惨淡的人生。",
      "src": "鲁迅《记念刘和珍君》",
      "mood": "清醒"
    },
    {
      "text": "从来如此，便对么？",
      "src": "鲁迅《狂人日记》",
      "mood": "清醒"
    },
    {
      "text": "唯沉默是最高的轻蔑。",
      "src": "鲁迅《且介亭杂文末编》",
      "mood": "清醒"
    },
    {
      "text": "家人闲坐，灯火可亲。",
      "src": "汪曾祺《冬天》",
      "mood": "具体"
    },
    {
      "text": "一定要，爱着点什么。",
      "src": "汪曾祺《人间草木》",
      "mood": "允许"
    },
    {
      "text": "它让我们变得坚韧，宽容，充盈。",
      "src": "汪曾祺《人间草木》",
      "mood": "允许"
    },
    {
      "text": "世界先爱了我，我不能不爱它。",
      "src": "汪曾祺《人间草木》",
      "mood": "允许"
    },
    {
      "text": "我不在，请和我门外的花坐一会儿。",
      "src": "汪曾祺《人间草木》",
      "mood": "有趣"
    },
    {
      "text": "栀子花粗粗大大，又香得掸都掸不开。",
      "src": "汪曾祺《人间草木》",
      "mood": "有趣"
    },
    {
      "text": "人间存一角，聊放侧枝花。",
      "src": "汪曾祺《我为什么写作》",
      "mood": "允许"
    },
    {
      "text": "我行过许多地方的桥，看过许多次数的云。",
      "src": "沈从文《湘行散记》",
      "mood": "距离"
    },
    {
      "text": "凡事都有偶然的凑巧，结果却又如宿命的必然。",
      "src": "沈从文《湘行散记》",
      "mood": "清醒"
    },
    {
      "text": "美丽总是愁人的。",
      "src": "沈从文《湘行散记》",
      "mood": "清醒"
    },
    {
      "text": "这个人也许永远不回来了，也许明天回来。",
      "src": "沈从文《边城》",
      "mood": "允许"
    },
    {
      "text": "所谓无底深渊，下去，也是前程万里。",
      "src": "木心《素履之往》",
      "mood": "距离"
    },
    {
      "text": "岁月不饶人，我亦未曾饶过岁月。",
      "src": "木心《云雀叫了一整天》",
      "mood": "清醒"
    },
    {
      "text": "我是一个在黑暗中大雪纷飞的人哪。",
      "src": "木心《云雀叫了一整天》",
      "mood": "具体"
    },
    {
      "text": "万头攒动火树银花之处不必找我。",
      "src": "木心《云雀叫了一整天》",
      "mood": "允许"
    },
    {
      "text": "生命好在无意义，才容得下各自赋予意义。",
      "src": "木心《文学回忆录》",
      "mood": "距离"
    },
    {
      "text": "从前的日色变得慢，车，马，邮件都慢。",
      "src": "木心《从前慢》",
      "mood": "具体"
    },
    {
      "text": "一生只够爱一个人。",
      "src": "木心《从前慢》",
      "mood": "具体"
    },
    {
      "text": "就命运而言，休论公道。",
      "src": "史铁生《我与地坛》",
      "mood": "允许"
    },
    {
      "text": "死是一件不必急于求成的事。",
      "src": "史铁生《我与地坛》",
      "mood": "允许"
    },
    {
      "text": "死是一个必然会降临的节日。",
      "src": "史铁生《我与地坛》",
      "mood": "距离"
    },
    {
      "text": "他每时每刻都是夕阳也都是旭日。",
      "src": "史铁生《我与地坛》",
      "mood": "距离"
    },
    {
      "text": "人的命就像这琴弦，拉紧了才能弹好。",
      "src": "史铁生《命若琴弦》",
      "mood": "起身"
    },
    {
      "text": "一个人只拥有此生此世是不够的。",
      "src": "王小波《万寿寺》",
      "mood": "距离"
    },
    {
      "text": "他还应该拥有诗意的世界。",
      "src": "王小波《万寿寺》",
      "mood": "距离"
    },
    {
      "text": "生活就是个缓慢受锤的过程。",
      "src": "王小波《黄金时代》",
      "mood": "清醒"
    },
    {
      "text": "那一天我二十一岁，在我一生的黄金时代。",
      "src": "王小波《黄金时代》",
      "mood": "具体"
    },
    {
      "text": "人是为了活着本身而活着。",
      "src": "余华《活着》自序",
      "mood": "清醒"
    },
    {
      "text": "以笑的方式哭，在死亡的伴随下活着。",
      "src": "余华《活着》",
      "mood": "清醒"
    },
    {
      "text": "人还要有点儿东西，才叫活着。",
      "src": "阿城《棋王》",
      "mood": "清醒"
    },
    {
      "text": "衣食是本，自有人类，就是每日在忙这个。",
      "src": "阿城《棋王》",
      "mood": "清醒"
    },
    {
      "text": "因为懂得，所以慈悲。",
      "src": "张爱玲",
      "mood": "允许"
    },
    {
      "text": "于千万人之中遇见你所要遇见的人。",
      "src": "张爱玲《爱》",
      "mood": "具体"
    },
    {
      "text": "没有早一步，也没有晚一步。",
      "src": "张爱玲《爱》",
      "mood": "具体"
    },
    {
      "text": "生命是一袭华美的袍，爬满了蚤子。",
      "src": "张爱玲《天才梦》",
      "mood": "清醒"
    },
    {
      "text": "出名要趁早呀。",
      "src": "张爱玲《传奇》再版序",
      "mood": "起身"
    },
    {
      "text": "我和谁都不争，和谁争我都不屑。",
      "src": "兰德《生与死》杨绛译",
      "mood": "允许"
    },
    {
      "text": "我双手烤着生命之火取暖。",
      "src": "兰德《生与死》杨绛译",
      "mood": "距离"
    },
    {
      "text": "惟有身处卑微的人，最能看到世态人情的真相。",
      "src": "杨绛《将饮茶》",
      "mood": "清醒"
    },
    {
      "text": "围在城里的人想逃出来，城外的人想冲进去。",
      "src": "钱锺书《围城》",
      "mood": "清醒"
    },
    {
      "text": "忠厚老实人的恶毒，像饭里的沙砾。",
      "src": "钱锺书《围城》",
      "mood": "清醒"
    },
    {
      "text": "黑夜给了我黑色的眼睛，我却用它寻找光明。",
      "src": "顾城《一代人》",
      "mood": "起身"
    },
    {
      "text": "草在结它的种子，风在摇它的叶子。",
      "src": "顾城《门前》",
      "mood": "具体"
    },
    {
      "text": "我们站着，不说话，就十分美好。",
      "src": "顾城《门前》",
      "mood": "具体"
    },
    {
      "text": "面朝大海，春暖花开。",
      "src": "海子《面朝大海，春暖花开》",
      "mood": "具体"
    },
    {
      "text": "从明天起，做一个幸福的人。",
      "src": "海子《面朝大海，春暖花开》",
      "mood": "起身"
    },
    {
      "text": "喂马，劈柴，周游世界。",
      "src": "海子《面朝大海，春暖花开》",
      "mood": "具体"
    },
    {
      "text": "陌生人，我也为你祝福。",
      "src": "海子《面朝大海，春暖花开》",
      "mood": "有趣"
    },
    {
      "text": "卑鄙是卑鄙者的通行证。",
      "src": "北岛《回答》",
      "mood": "清醒"
    },
    {
      "text": "高尚是高尚者的墓志铭。",
      "src": "北岛《回答》",
      "mood": "清醒"
    },
    {
      "text": "走吧，我们没有失去记忆。",
      "src": "北岛《走吧》",
      "mood": "起身"
    },
    {
      "text": "我必须是你近旁的一株木棉。",
      "src": "舒婷《致橡树》",
      "mood": "清醒"
    },
    {
      "text": "仿佛永远分离，却又终身相依。",
      "src": "舒婷《致橡树》",
      "mood": "具体"
    },
    {
      "text": "撑着油纸伞，独自彷徨在悠长的雨巷。",
      "src": "戴望舒《雨巷》",
      "mood": "具体"
    },
    {
      "text": "轻轻的我走了，正如我轻轻的来。",
      "src": "徐志摩《再别康桥》",
      "mood": "具体"
    },
    {
      "text": "我挥一挥衣袖，不带走一片云彩。",
      "src": "徐志摩《再别康桥》",
      "mood": "允许"
    },
    {
      "text": "得之我幸，失之我命。",
      "src": "徐志摩致梁启超书",
      "mood": "允许"
    },
    {
      "text": "你站在桥上看风景，看风景的人在楼上看你。",
      "src": "卞之琳《断章》",
      "mood": "距离"
    },
    {
      "text": "明月装饰了你的窗子，你装饰了别人的梦。",
      "src": "卞之琳《断章》",
      "mood": "距离"
    },
    {
      "text": "我身上有一个不可战胜的夏天。",
      "src": "加缪《夏天集·重返蒂巴萨》",
      "mood": "起身"
    },
    {
      "text": "应该想象西西弗是幸福的。",
      "src": "加缪《西西弗神话》",
      "mood": "允许"
    },
    {
      "text": "攀登山顶的斗争本身足以充实人的心灵。",
      "src": "加缪《西西弗神话》",
      "mood": "起身"
    },
    {
      "text": "有何胜利可言，挺住意味着一切。",
      "src": "里尔克《安魂曲》",
      "mood": "起身"
    },
    {
      "text": "你要容忍那些未解决的问题。",
      "src": "里尔克《给青年诗人的信》",
      "mood": "允许"
    },
    {
      "text": "去爱这些问题本身。",
      "src": "里尔克《给青年诗人的信》",
      "mood": "允许"
    },
    {
      "text": "谁此时没有房屋，就不必建筑。",
      "src": "里尔克《秋日》北岛译",
      "mood": "允许"
    },
    {
      "text": "谁此时孤独，就永远孤独。",
      "src": "里尔克《秋日》北岛译",
      "mood": "清醒"
    },
    {
      "text": "让最后的果实长得丰满。",
      "src": "里尔克《秋日》北岛译",
      "mood": "具体"
    },
    {
      "text": "你不需要离开房间，坐在桌前倾听即可。",
      "src": "卡夫卡《箴言》",
      "mood": "允许"
    },
    {
      "text": "甚至不必倾听，等待就是。",
      "src": "卡夫卡《箴言》",
      "mood": "允许"
    },
    {
      "text": "一本书应是砍破内心冰海的斧头。",
      "src": "卡夫卡《致波拉克的信》",
      "mood": "清醒"
    },
    {
      "text": "天堂应该是图书馆的模样。",
      "src": "博尔赫斯《关于天赐的诗》",
      "mood": "有趣"
    },
    {
      "text": "时间是构成我的实体。",
      "src": "博尔赫斯《驳时间》",
      "mood": "距离"
    },
    {
      "text": "我喜欢你是寂静的，仿佛你消失了一样。",
      "src": "聂鲁达《二十首情诗》",
      "mood": "具体"
    },
    {
      "text": "爱情太短，遗忘太长。",
      "src": "聂鲁达《二十首情诗》",
      "mood": "清醒"
    },
    {
      "text": "我偏爱写诗的荒谬，胜过不写诗的荒谬。",
      "src": "辛波斯卡《种种可能》",
      "mood": "有趣"
    },
    {
      "text": "我偏爱例外。",
      "src": "辛波斯卡《种种可能》",
      "mood": "有趣"
    },
    {
      "text": "我为称之为必然向偶然致歉。",
      "src": "辛波斯卡《在一颗小星星下》",
      "mood": "有趣"
    },
    {
      "text": "我道歉，我不能无所不在。",
      "src": "辛波斯卡《在一颗小星星下》",
      "mood": "有趣"
    },
    {
      "text": "我的心略大于整个宇宙。",
      "src": "佩索阿《不安之书》",
      "mood": "距离"
    },
    {
      "text": "生活是一场实验性的旅行。",
      "src": "佩索阿《不安之书》",
      "mood": "距离"
    },
    {
      "text": "树木一直是最动人心弦的说教者。",
      "src": "黑塞《漫游》",
      "mood": "具体"
    },
    {
      "text": "鸟要挣脱出壳。蛋就是世界。",
      "src": "黑塞《德米安》",
      "mood": "起身"
    },
    {
      "text": "谁要诞生，就得摧毁一个世界。",
      "src": "黑塞《德米安》",
      "mood": "起身"
    },
    {
      "text": "我步入丛林，因为我希望生活得有意义。",
      "src": "梭罗《瓦尔登湖》",
      "mood": "起身"
    },
    {
      "text": "我愿意深深扎入生活，吮尽生活的骨髓。",
      "src": "梭罗《瓦尔登湖》",
      "mood": "起身"
    },
    {
      "text": "大多数人生活在平静的绝望中。",
      "src": "梭罗《瓦尔登湖》",
      "mood": "清醒"
    },
    {
      "text": "简单，简单，再简单。",
      "src": "梭罗《瓦尔登湖》",
      "mood": "清醒"
    },
    {
      "text": "我的生活充满可怕的不幸，多数从未发生。",
      "src": "蒙田《随笔集》",
      "mood": "清醒"
    },
    {
      "text": "你拥有支配自己心灵的力量，而非外在事件。",
      "src": "马可·奥勒留《沉思录》",
      "mood": "清醒"
    },
    {
      "text": "不要浪费余生去想别人。",
      "src": "马可·奥勒留《沉思录》",
      "mood": "允许"
    },
    {
      "text": "没有一处退隐之地，胜过自己的心灵。",
      "src": "马可·奥勒留《沉思录》",
      "mood": "允许"
    },
    {
      "text": "我们受苦，往往源于想象，而非现实。",
      "src": "塞涅卡《道德书简》",
      "mood": "清醒"
    },
    {
      "text": "生命如果懂得利用，就是长久的。",
      "src": "塞涅卡《论生命之短暂》",
      "mood": "距离"
    },
    {
      "text": "我能抵抗一切，除了诱惑。",
      "src": "王尔德《温夫人的扇子》",
      "mood": "有趣"
    },
    {
      "text": "我们都生活在阴沟里，但仍有人仰望星空。",
      "src": "王尔德《温夫人的扇子》",
      "mood": "起身"
    },
    {
      "text": "爱自己是终身浪漫的开始。",
      "src": "王尔德《理想丈夫》",
      "mood": "有趣"
    },
    {
      "text": "生活模仿艺术，远甚于艺术模仿生活。",
      "src": "王尔德《谎言的衰朽》",
      "mood": "有趣"
    },
    {
      "text": "人的一切都应该是美丽的。",
      "src": "契诃夫《万尼亚舅舅》",
      "mood": "具体"
    },
    {
      "text": "幸福的家庭都是相似的。",
      "src": "托尔斯泰《安娜·卡列尼娜》",
      "mood": "清醒"
    },
    {
      "text": "不幸的家庭各有各的不幸。",
      "src": "托尔斯泰《安娜·卡列尼娜》",
      "mood": "清醒"
    },
    {
      "text": "我怕我配不上自己所受的苦难。",
      "src": "陀思妥耶夫斯基《卡拉马佐夫兄弟》",
      "mood": "清醒"
    },
    {
      "text": "美将拯救世界。",
      "src": "陀思妥耶夫斯基《白痴》",
      "mood": "起身"
    },
    {
      "text": "过去都是假的，回忆是一条没有归路的路。",
      "src": "马尔克斯《百年孤独》",
      "mood": "清醒"
    },
    {
      "text": "在地狱里寻找非地狱的人和物。",
      "src": "卡尔维诺《看不见的城市》",
      "mood": "起身"
    },
    {
      "text": "记忆中的形象一旦被词语固定，就会消失。",
      "src": "卡尔维诺《看不见的城市》",
      "mood": "清醒"
    },
    {
      "text": "必须有钱，再加一间自己的房间。",
      "src": "伍尔夫《一间自己的房间》",
      "mood": "清醒"
    },
    {
      "text": "你锁得住图书馆，锁不住我思想的自由。",
      "src": "伍尔夫《一间自己的房间》",
      "mood": "起身"
    },
    {
      "text": "你的孩子，其实不是你的孩子。",
      "src": "纪伯伦《先知》",
      "mood": "清醒"
    },
    {
      "text": "他们借你而来，却非因你而来。",
      "src": "纪伯伦《先知》",
      "mood": "清醒"
    },
    {
      "text": "你可以给他们爱，却不能给他们思想。",
      "src": "纪伯伦《先知》",
      "mood": "清醒"
    },
    {
      "text": "理论是灰色的，生命之树常青。",
      "src": "歌德《浮士德》",
      "mood": "起身"
    },
    {
      "text": "那不能杀死我的，使我更强大。",
      "src": "尼采《偶像的黄昏》",
      "mood": "起身"
    },
    {
      "text": "每一个不曾起舞的日子，都是对生命的辜负。",
      "src": "尼采《偶像的黄昏》",
      "mood": "起身"
    },
    {
      "text": "与怪物战斗的人，当心自己成为怪物。",
      "src": "尼采《善恶的彼岸》",
      "mood": "清醒"
    },
    {
      "text": "当你凝视深渊时，深渊也在凝视你。",
      "src": "尼采《善恶的彼岸》",
      "mood": "清醒"
    },
    {
      "text": "认清生活的真相之后依然热爱生活。",
      "src": "罗曼·罗兰《米开朗基罗传》",
      "mood": "起身"
    },
    {
      "text": "一个人可以被毁灭，但不能被打败。",
      "src": "海明威《老人与海》",
      "mood": "起身"
    },
    {
      "text": "该想想凭现有的东西能做什么。",
      "src": "海明威《老人与海》",
      "mood": "清醒"
    },
    {
      "text": "生如夏花之绚烂，死如秋叶之静美。",
      "src": "泰戈尔《飞鸟集》郑振铎译",
      "mood": "距离"
    },
    {
      "text": "世界以痛吻我，要我报之以歌。",
      "src": "泰戈尔《飞鸟集》郑振铎译",
      "mood": "允许"
    },
    {
      "text": "天空没有翅膀的痕迹，而我已飞过。",
      "src": "泰戈尔《飞鸟集》郑振铎译",
      "mood": "距离"
    },
    {
      "text": "因失去太阳而流泪，你将失去群星。",
      "src": "泰戈尔《飞鸟集》郑振铎译",
      "mood": "允许"
    },
    {
      "text": "假如生活欺骗了你，不要悲伤，不要心急。",
      "src": "普希金《假如生活欺骗了你》",
      "mood": "允许"
    },
    {
      "text": "一切都是瞬息，一切都将会过去。",
      "src": "普希金《假如生活欺骗了你》",
      "mood": "允许"
    },
    {
      "text": "而那过去了的，就会成为亲切的怀恋。",
      "src": "普希金《假如生活欺骗了你》",
      "mood": "距离"
    },
    {
      "text": "只有一个人爱你朝圣者的灵魂。",
      "src": "叶芝《当你老了》袁可嘉译",
      "mood": "具体"
    },
    {
      "text": "林中有两条路，我选了人迹罕至的一条。",
      "src": "弗罗斯特《未选择的路》",
      "mood": "起身"
    },
    {
      "text": "而这让一切都不同了。",
      "src": "弗罗斯特《未选择的路》",
      "mood": "起身"
    },
    {
      "text": "希望是长着羽毛的东西。",
      "src": "狄金森",
      "mood": "具体"
    },
    {
      "text": "做一个世界的水手，奔赴所有的港口。",
      "src": "惠特曼《草叶集》",
      "mood": "起身"
    },
    {
      "text": "人类全部智慧包含在两个词里：等待和希望。",
      "src": "大仲马《基督山伯爵》",
      "mood": "允许"
    },
    {
      "text": "我更爱你现在备受摧残的面容。",
      "src": "杜拉斯《情人》",
      "mood": "具体"
    },
    {
      "text": "暴风雨结束后，你不会记得自己怎样活下来。",
      "src": "村上春树《海边的卡夫卡》",
      "mood": "距离"
    },
    {
      "text": "死并非生的对立面，而作为生的一部分永存。",
      "src": "村上春树《挪威的森林》",
      "mood": "距离"
    }
  ],
